root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# --- TypeScript / JavaScript ---
[*.{ts,tsx,js,jsx}]
indent_style = space
indent_size = 2
max_line_length = 100

# --- Python ---
[*.py]
indent_style = space
indent_size = 4
max_line_length = 88

# --- C++ ---
[*.{cpp,h,hpp,c}]
indent_style = space
indent_size = 4
max_line_length = 120

# --- Markdown / Docs ---
[*.md]
trim_trailing_whitespace = false
